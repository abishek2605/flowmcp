# Load this via node --env-file=/secure/path/flow.env src/main.mjs.
# Never commit the real file. Owner-only permissions (0600).
PORT=3000
FLOW_BACKEND_DIR=/workspace/shared/flow-backend
FLOW_GATEWAY_STATE=/workspace/shared/flow-state
FLOW_MCP_HOME=/workspace/shared/flow-state/browser
FLOW_MCP_OUTPUT=/workspace/shared/flow-state/outputs
FLOW_MCP_CHROME=/usr/bin/chromium
FLOW_MCP_CDP_PORT=9333
# Deployment requires all three real values; no public endpoint exists yet.
# FLOW_PUBLIC_URL=
# FLOW_OAUTH_ISSUER=
# FLOW_ALLOWED_SUBJECTS=
# Local transport testing only: path to a random 32+ character token, outside Git.
# FLOW_TOKEN_FILE=
